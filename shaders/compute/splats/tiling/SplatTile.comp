#version 450
#extension GL_GOOGLE_include_directive : require

#include "SplatStructures.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 2, binding = 1, std430) readonly buffer ProjectedSplatBuffer
{
    ProjectedSplat splats[];
}
projectedSplatBuffer;

layout(set = 2, binding = 2, std430) readonly buffer VisibleSplatIndexBuffer
{
    uint indices[];
}
visibleSplatIndexBuffer;

layout(set = 2, binding = 3, std430) writeonly buffer SplatEntryKeyBuffer
{
    SplatEntryKey keys[];
}
splatEntryKeyBuffer;

layout(set = 2, binding = 5, std430) writeonly buffer EntrySplatIndexBuffer
{
    uint indices[];
}
entrySplatIndexBuffer;

layout(set = 2, binding = 7, std430) buffer SplatCounterBuffer
{
    uint visibleCount;
    uint entryCount;
    uint requestedEntryCount;
    uint overflowCount;
}
counters;

layout(set = 2, binding = 10, std430) readonly buffer SplatEntryRangeBuffer
{
    SplatEntryRange ranges[];
}
splatEntryRangeBuffer;

layout(push_constant) uniform PushConstants
{
    mat4 view;
    vec4 cameraPosition;
    vec4 projectionInfo;
    uvec4 renderInfo;
}
pushConstants;

const uint SPLAT_TILE_SIZE = 16;

void main()
{
    uint visibleIndex = gl_GlobalInvocationID.x;
    if(visibleIndex >= counters.visibleCount)
        return;

    uint splatIndex = visibleSplatIndexBuffer.indices[visibleIndex];
    ProjectedSplat splat = projectedSplatBuffer.splats[splatIndex];

    uvec2 tileSpan = (
        splat.tileBounds.zw -
        splat.tileBounds.xy +
        uvec2(1)
    );

    SplatEntryRange entryRange =
        splatEntryRangeBuffer.ranges[visibleIndex];

    uint splatEntryCount = entryRange.entryCount;
    uint firstEntry = entryRange.entryOffset;

    uint entryCapacity = entrySplatIndexBuffer.indices.length();
    if(firstEntry >= entryCapacity)
        return;

    uint writableEntryCount = min(
        splatEntryCount,
        entryCapacity - firstEntry
    );

    uint tileCountX = (
        (pushConstants.renderInfo.x + SPLAT_TILE_SIZE - 1) /
        SPLAT_TILE_SIZE
    );

    uint depthKey = floatBitsToUint(splat.clipCenter.w);

    for(uint entryOffset = 0; entryOffset < writableEntryCount; entryOffset++)
    {
        uint tileX = (
            splat.tileBounds.x +
            (entryOffset % tileSpan.x)
        );

        uint tileY = (
            splat.tileBounds.y +
            (entryOffset / tileSpan.x)
        );

        uint tileIndex = (tileY * tileCountX) + tileX;
        uint entryIndex = firstEntry + entryOffset;

        splatEntryKeyBuffer.keys[entryIndex].tileIndex = tileIndex;
        splatEntryKeyBuffer.keys[entryIndex].depthKey = depthKey;
        entrySplatIndexBuffer.indices[entryIndex] = splatIndex;
    }
}
