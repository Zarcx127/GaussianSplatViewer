#version 450
#extension GL_GOOGLE_include_directive : require

#include "SplatStructures.glsl"

layout(
    local_size_x = 256,
    local_size_y = 1,
    local_size_z = 1
) in;

layout(set = 2, binding = 3, std430) buffer SplatEntryKeyBufferA
{
    SplatEntryKey keys[];
}
entryKeyBufferA;

layout(set = 2, binding = 4, std430) buffer SplatEntryKeyBufferB
{
    SplatEntryKey keys[];
}
entryKeyBufferB;

layout(set = 2, binding = 5, std430) buffer EntrySplatIndexBufferA
{
    uint indices[];
}
entrySplatIndexBufferA;

layout(set = 2, binding = 6, std430) buffer EntrySplatIndexBufferB
{
    uint indices[];
}
entrySplatIndexBufferB;

layout(set = 2, binding = 7, std430) readonly buffer SplatCounterBuffer
{
    uint visibleCount;
    uint entryCount;
    uint requestedEntryCount;
    uint overflowCount;
}
counters;

layout(set = 2, binding = 12, std430) readonly buffer RadixHistogramBuffer
{
    uint values[];
}
radixHistogramBuffer;

layout(set = 2, binding = 14, std430) readonly buffer RadixBucketOffsetBuffer
{
    uint values[];
}
radixBucketOffsetBuffer;

layout(push_constant) uniform SortPushConstants
{
    layout(offset = 112) uint digitShift;

    uint keyComponent;
    uint inputBufferIndex;
    uint outputBufferIndex;
}
sortPushConstants;

const uint SPLAT_SORT_LOCAL_SIZE = 256;

const uint SPLAT_SORT_RADIX_BITS = 4;
const uint SPLAT_SORT_RADIX_BUCKET_COUNT = (
    1U << SPLAT_SORT_RADIX_BITS
);

const uint SPLAT_SORT_KEY_DEPTH = 0;
const uint SPLAT_SORT_KEY_TILE = 1;

shared uint localBuckets[SPLAT_SORT_LOCAL_SIZE];

shared uint localBucketCounts[
    SPLAT_SORT_RADIX_BUCKET_COUNT
];

shared uint localOrder[2][SPLAT_SORT_LOCAL_SIZE];
shared uint scanValues[SPLAT_SORT_LOCAL_SIZE];

shared uint oneCount;

SplatEntryKey read_entry_key(uint entryIndex)
{
    if(sortPushConstants.inputBufferIndex == 0)
        return entryKeyBufferA.keys[entryIndex];

    return entryKeyBufferB.keys[entryIndex];
}

uint read_splat_index(uint entryIndex)
{
    if(sortPushConstants.inputBufferIndex == 0)
        return entrySplatIndexBufferA.indices[entryIndex];

    return entrySplatIndexBufferB.indices[entryIndex];
}

void write_entry(
    uint entryIndex,
    SplatEntryKey key,
    uint splatIndex
) {
    if(sortPushConstants.outputBufferIndex == 0)
    {
        entryKeyBufferA.keys[entryIndex] = key;
        entrySplatIndexBufferA.indices[entryIndex] =
            splatIndex;

        return;
    }

    entryKeyBufferB.keys[entryIndex] = key;
    entrySplatIndexBufferB.indices[entryIndex] =
        splatIndex;
}

uint extract_bucket(SplatEntryKey key)
{
    uint keyValue = key.depthKey;

    if(sortPushConstants.keyComponent == SPLAT_SORT_KEY_TILE)
        keyValue = key.tileIndex;

    return (
        (
            keyValue >>
            sortPushConstants.digitShift
        ) &
        (SPLAT_SORT_RADIX_BUCKET_COUNT - 1)
    );
}

void stable_partition(
    uint sourceOrderIndex,
    uint destinationOrderIndex,
    uint bitIndex
) {
    uint localIndex = gl_LocalInvocationIndex;

    uint originalLocalIndex =
        localOrder[sourceOrderIndex][localIndex];

    uint bitValue = (
        localBuckets[originalLocalIndex] >>
        bitIndex
    ) & 1U;

    scanValues[localIndex] = bitValue;

    barrier();

    for(
        uint offset = 1;
        offset < SPLAT_SORT_LOCAL_SIZE;
        offset <<= 1
    ) {
        uint index = (
            ((localIndex + 1) * offset * 2) -
            1
        );

        if(index < SPLAT_SORT_LOCAL_SIZE)
        {
            scanValues[index] +=
                scanValues[index - offset];
        }

        barrier();
    }

    if(localIndex == 0)
    {
        uint finalIndex =
            SPLAT_SORT_LOCAL_SIZE - 1;

        oneCount = scanValues[finalIndex];
        scanValues[finalIndex] = 0;
    }

    barrier();

    for(
        uint offset = SPLAT_SORT_LOCAL_SIZE >> 1;
        offset > 0;
        offset >>= 1
    ) {
        uint index = (
            ((localIndex + 1) * offset * 2) -
            1
        );

        if(index < SPLAT_SORT_LOCAL_SIZE)
        {
            uint leftValue =
                scanValues[index - offset];

            scanValues[index - offset] =
                scanValues[index];

            scanValues[index] += leftValue;
        }

        barrier();
    }

    uint onePrefix = scanValues[localIndex];
    uint zeroCount = SPLAT_SORT_LOCAL_SIZE - oneCount;

    uint destinationIndex = (
        (bitValue == 0)
            ? localIndex - onePrefix
            : zeroCount + onePrefix
    );

    localOrder[destinationOrderIndex][destinationIndex] =
        originalLocalIndex;

    barrier();
}

void main()
{
    uint localIndex = gl_LocalInvocationIndex;

    uint workgroupIndex = (
        gl_WorkGroupID.x +
        (gl_WorkGroupID.y * gl_NumWorkGroups.x)
    );

    uint workgroupCapacity = (
        uint(radixHistogramBuffer.values.length()) /
        SPLAT_SORT_RADIX_BUCKET_COUNT
    );

    if(workgroupIndex >= workgroupCapacity)
        return;

    uint firstEntry = (
        workgroupIndex *
        SPLAT_SORT_LOCAL_SIZE
    );

    uint validEntryCount = 0;

    if(firstEntry < counters.entryCount)
    {
        validEntryCount = min(
            SPLAT_SORT_LOCAL_SIZE,
            counters.entryCount - firstEntry
        );
    }

    if(localIndex < SPLAT_SORT_RADIX_BUCKET_COUNT)
        localBucketCounts[localIndex] = 0;

    localOrder[0][localIndex] = localIndex;

    barrier();

    if(localIndex < validEntryCount)
    {
        SplatEntryKey key = read_entry_key(
            firstEntry + localIndex
        );

        uint bucketIndex = extract_bucket(key);

        localBuckets[localIndex] = bucketIndex;

        atomicAdd(
            localBucketCounts[bucketIndex],
            1
        );
    }
    else
    {
        localBuckets[localIndex] =
            SPLAT_SORT_RADIX_BUCKET_COUNT - 1;
    }

    barrier();

    stable_partition(0, 1, 0);
    stable_partition(1, 0, 1);
    stable_partition(0, 1, 2);
    stable_partition(1, 0, 3);

    uint originalLocalIndex =
        localOrder[0][localIndex];

    if(originalLocalIndex >= validEntryCount)
        return;

    uint inputEntryIndex = (
        firstEntry +
        originalLocalIndex
    );

    SplatEntryKey key =
        read_entry_key(inputEntryIndex);

    uint splatIndex =
        read_splat_index(inputEntryIndex);

    uint bucketIndex =
        localBuckets[originalLocalIndex];

    uint localBucketOffset = 0;

    for(
        uint precedingBucket = 0;
        precedingBucket < bucketIndex;
        precedingBucket++
    ) {
        localBucketOffset +=
            localBucketCounts[precedingBucket];
    }

    uint localRank = (
        localIndex -
        localBucketOffset
    );

    uint histogramIndex = (
        (bucketIndex * workgroupCapacity) +
        workgroupIndex
    );

    uint outputEntryIndex = (
        radixBucketOffsetBuffer.values[bucketIndex] +
        radixHistogramBuffer.values[histogramIndex] +
        localRank
    );

    write_entry(
        outputEntryIndex,
        key,
        splatIndex
    );
}
