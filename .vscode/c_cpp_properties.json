{
    "configurations": [
        {
            "name": "Win-32",
            "compilerPath": "${workspaceFolder}/.toolchain/ucrt64/bin/g++.exe",
            "intelliSenseMode": "gcc-x64",
            "includePath": [
                "${workspaceFolder}/include",
                "${env:VULKAN_SDK}/Include"
            ],
            "defines": [
                "DEBUG",
                "VULKAN_HPP_DISPATCH_LOADER_DYNAMIC=1",
                "VULKAN_HPP_NO_EXCEPTIONS",
                "GLFW_INCLUDE_NONE",
                "WIN32_LEAN_AND_MEAN",
                "_WIN32_WINNT=0x0A00",
                "WINVER=0x0A00"
            ],
            "cStandard": "c17",
            "cppStandard": "c++17"
        }
    ],
    "version": 4
}
